<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spike 1: live 3D editing paths.
      shared   turn the Spike 0 workspace into the shared workspace + a baseline index
      changes  list workspace files that differ from the baseline (the future project overlay)
      forge    read and round-trip MCC Forge map variants (.mvar) with ManagedBlam
      live     launch reach_tag_test and drive it live through RemoteCommand
      engine   start the engine inside our own process (GameEditor) and capture a rendered frame
    Same rules as Spike 0: net48 x64, never writes inside HREK or MCC.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>kalo-spike1</AssemblyName>
    <RootNamespace>Kalo.Spike1</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with Spike 0. -->
    <Compile Include="..\Kalo.Spike0\Hrek.cs" Link="Shared\Hrek.cs" />
    <Compile Include="..\Kalo.Spike0\Report.cs" Link="Shared\Report.cs" />
    <Compile Include="..\Kalo.Spike0\Snapshot.cs" Link="Shared\Snapshot.cs" />
    <Compile Include="..\Kalo.Spike0\BlamLoader.cs" Link="Shared\BlamLoader.cs" />
    <Compile Include="..\Kalo.Spike0\SpikeAbort.cs" Link="Shared\SpikeAbort.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="ManagedBlam">
      <HintPath>$(HrekRoot)\bin\ManagedBlam.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
