<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Let the engine probe catch access violations from native code instead of dying silently. -->
    <legacyCorruptedStateExceptionsPolicy enabled="true" />
  </runtime>
</configuration>
