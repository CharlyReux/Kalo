<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kalo's non-UI services: Blam Host client, workspace and baseline, game sessions. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kalo.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kalo.Protocol\Kalo.Protocol.csproj" />
    <!-- Ogg Vorbis decoder for sound previews (MIT) -->
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every HaloScript function and engine global (the game's script_doc output), for mission script help and checks. -->
    <EmbeddedResource Include="Scripting\Campaign\hs_doc.txt" LogicalName="Kalo.HsDoc" />
  </ItemGroup>

</Project>
