<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kalo.App.ViewModels"
             x:Class="Kalo.App.Views.TagEditorView"
             x:DataType="vm:TagEditorViewModel">

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1">
      <!-- View controls, then actions; the actions go to a second row when the editor is narrow (nothing is cut). -->
      <WrapPanel Orientation="Horizontal" Margin="10,2">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,24,3">
            <Border BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" ClipToBounds="True">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="seg" Content="Simple" IsChecked="{Binding ShowSimple, Mode=TwoWay}" IsVisible="{Binding HasSimpleView}"
                              ToolTip.Tip="Only the settings most people change, with plain names" />
                <ToggleButton Classes="seg" Content="All fields" IsChecked="{Binding ShowLabeled, Mode=TwoWay}"
                              ToolTip.Tip="Every field, with readable names" />
                <ToggleButton Classes="seg" Content="Raw" IsChecked="{Binding ShowRaw, Mode=TwoWay}"
                            ToolTip.Tip="Every field with the engine's own names and types (for guides written for Guerilla)" />
              </StackPanel>
            </Border>
            <TextBox Classes="compact" Width="200" Watermark="Filter fields" Text="{Binding Filter}" Margin="0,0,8,0" />
            <CheckBox Content="Changed only" MinWidth="110" IsChecked="{Binding ChangedOnly}" FontSize="12" Margin="0,0,8,0" />
            <Button Classes="tool" Command="{Binding ExpandAllCommand}" ToolTip.Tip="Expand all">
              <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE70D;" FontSize="12" />
            </Button>
            <Button Classes="tool" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse all">
              <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE70E;" FontSize="12" />
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3">
            <Button Classes="outline" Content="Compare" Command="{Binding CompareCommand}" IsEnabled="{Binding DiffersFromVanilla}"
                    ToolTip.Tip="List the fields that differ from the game's original file (unsaved edits included)" />
            <Button Classes="outline" Content="Revert to original" Command="{Binding RevertToVanillaCommand}" IsEnabled="{Binding DiffersFromVanilla}"
                    ToolTip.Tip="Put the game's original version of this file back" />
            <TextBlock Text="{Binding ScriptNameText}" IsVisible="{Binding ShowScriptName}" VerticalAlignment="Center" Foreground="{StaticResource KMuted}"
                       ToolTip.Tip="Gametype scripts create this object with create_object(&quot;name&quot;, at ...)" />
            <Button Classes="outline" Content="Rename…" IsVisible="{Binding ShowScriptName}" Click="RenameScriptName_Click"
                    ToolTip.Tip="Change the name scripts use for this object" />
            <Button Classes="outline" Content="Remove from scripts" IsVisible="{Binding ShowScriptName}" IsEnabled="{Binding CanRemoveScriptName}"
                    Command="{Binding RemoveScriptNameCommand}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding RemoveScriptNameTip}" />
            <Button Classes="outline" Content="Use in scripts…" IsVisible="{Binding ShowUseInScripts}" Click="UseInScripts_Click"
                    ToolTip.Tip="Let gametype scripts create this object: create_object(&quot;name&quot;, at ...)" />
            <Button Classes="outline" Content="New weapon from this…" Click="NewWeapon_Click" IsVisible="{Binding IsWeapon}"
                    ToolTip.Tip="A new weapon in your mod, made from this one (with your edits), with its own bullet and damage files: change its damage without changing this weapon." />
            <Button Classes="outline" Content="Save as new…" Click="SaveAsNew_Click"
                    ToolTip.Tip="Save this file, with your edits, as a new file in your mod (e.g. a new object based on this one). This file itself is not changed." />
            <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" ToolTip.Tip="Save (Ctrl+S). A running game reloads it." />
          </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Objects: use it in a map (multiplayer or campaign) -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" Padding="12,4" IsVisible="{Binding IsPlaceable}">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="Use it" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button Classes="outline" Content="Place in map" Command="{Binding PlaceInMapCommand}" Margin="0,2,6,2"
                ToolTip.Tip="Places it in front of the camera of the map tab you opened last (multiplayer map or campaign mission)" />
        <Button Classes="outline" Content="Add to map palette" Command="{Binding AddToMapPaletteCommand}" Margin="0,2,6,2"
                ToolTip.Tip="Adds it to that map's palette without placing it: in a mission, squads can then carry it (Squad section › Weapon)" />
        <TextBlock Text="{Binding UseStatus}" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
      </WrapPanel>
    </Border>

    <!-- Objects: their look (paint, or another object's model) -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" Padding="12,4" IsVisible="{Binding IsPlaceable}">
      <StackPanel Spacing="4">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="Look" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ToggleButton Classes="outline" Content="Paint…" IsChecked="{Binding IsPaintOpen, Mode=OneWay}" Command="{Binding TogglePaintCommand}" Margin="0,2,6,2"
                        ToolTip.Tip="Paint every surface with one of Reach's materials. Your mod's own objects are painted in place; the game's get a painted copy in your mod." />
          <Button Classes="outline" Content="Your picture…" Click="PaintPicture_Click" Margin="0,2,6,2"
                  ToolTip.Tip="Paint it with a PNG or JPEG of yours, wrapped over the object's parts (patterns work best). The game's own objects get a painted copy in your mod." />
          <ToggleButton Classes="outline" Content="Looks like…" IsChecked="{Binding IsLooksLikeOpen, Mode=OneWay}" Command="{Binding ToggleLooksLikeCommand}" Margin="0,2,6,2"
                        ToolTip.Tip="Take the model of another object of the same kind (a weapon for a weapon...). Everything else stays: stats, sounds, animations." />
          <TextBlock Text="{Binding LookStatus}" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
        </WrapPanel>
        <ScrollViewer IsVisible="{Binding IsPaintOpen}" MaxHeight="220">
          <ItemsControl ItemsSource="{Binding Main.Materials}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:MaterialChoice">
                <Button Padding="2" Margin="0,0,4,4" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Shader}"
                        Command="{Binding $parent[UserControl].((vm:TagEditorViewModel)DataContext).PaintWithCommand}" CommandParameter="{Binding}">
                  <StackPanel Width="56" Spacing="2">
                    <Image Source="{Binding Swatch}" Width="56" Height="56" Stretch="UniformToFill" />
                    <TextBlock Text="{Binding Name}" FontSize="9.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource KMuted}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <DockPanel IsVisible="{Binding IsLooksLikeOpen}">
          <TextBox DockPanel.Dock="Top" Classes="compact" Watermark="Search (e.g. dmr, rocket, crate)" Text="{Binding LooksLikeQuery}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,4" />
          <ListBox ItemsSource="{Binding LooksLikeResults}" MaxHeight="180" FontSize="12" DoubleTapped="LooksLike_DoubleTapped"
                   ToolTip.Tip="Double-click the object to look like" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Simple view: what it shows and where the rest is -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" Padding="12,6" IsVisible="{Binding ShowSimple}">
      <TextBlock Text="{Binding SimpleIntro}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KMuted}" />
    </Border>

    <!-- Weapons: what one shot does (from the bullet and its damage file, saved with the weapon) -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" Padding="12,8" IsVisible="{Binding ShowShot}">
      <StackPanel Spacing="6" DataContext="{Binding Shot}" x:DataType="vm:ShotInfo">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Each shot" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Files}" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center"
                     ToolTip.Tip="These numbers live in the bullet and its damage file. Save saves them with the weapon. Every weapon that fires the same bullet changes too." />
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,4" IsVisible="{Binding HasDamage}">
            <TextBlock Text="{Binding DamageLabel}" VerticalAlignment="Center" FontSize="12.5" />
            <TextBox Classes="compact" Width="90" Text="{Binding Damage, UpdateSourceTrigger=LostFocus}" KeyDown="ShotBox_KeyDown"
                     ToolTip.Tip="Damage of one hit: one number (20), or a range the game picks from (15 to 20). A Spartan has about 70 shield and 45 health points." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,4" IsVisible="{Binding HasSpeed}">
            <TextBlock Text="Bullet speed" VerticalAlignment="Center" FontSize="12.5" />
            <TextBox Classes="compact" Width="80" Text="{Binding Speed, UpdateSourceTrigger=LostFocus}" KeyDown="ShotBox_KeyDown"
                     ToolTip.Tip="World units per second (1 unit is about 3 meters). Its speed at the end of its flight changes in proportion." />
            <TextBlock Text="units/s" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource KMuted}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,4" IsVisible="{Binding HasRadius}">
            <TextBlock Text="Blast radius" VerticalAlignment="Center" FontSize="12.5" />
            <TextBox Classes="compact" Width="80" Text="{Binding Radius, UpdateSourceTrigger=LostFocus}" KeyDown="ShotBox_KeyDown"
                     ToolTip.Tip="One number: the edge of the blast (full damage in its inner third). Or inner, outer: full damage inside inner, fading to nothing at outer." />
            <TextBlock Text="units" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource KMuted}" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KMuted}" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KError}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- Column header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource KPanel}" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" Height="26">
      <Grid ColumnDefinitions="*,260,110,130" Margin="12,0,16,0">
        <TextBlock Grid.Column="0" Text="Field" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="Value" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="Units" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="Range / type" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid>
      <TextBlock Text="Loading…" Foreground="{StaticResource KMuted}" Margin="16" IsVisible="{Binding IsLoading}" />
      <TreeView x:Name="FieldTree" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" IsVisible="{Binding !IsLoading}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:FieldViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
          <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
          <Style Selector="TextBox.value">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontFamily" Value="{StaticResource KMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
          </Style>
          <Style Selector="TextBox.value.dirty">
            <Setter Property="Foreground" Value="{StaticResource KWarning}" />
          </Style>
          <Style Selector="TextBox.value.error">
            <Setter Property="BorderBrush" Value="{StaticResource KError}" />
          </Style>
          <Style Selector="ComboBox.value">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:FieldViewModel" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="*,260,110,130" MinHeight="24" Margin="0,0,4,0" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Add element" Command="{Binding AddElementCommand}" IsVisible="{Binding IsBlock}" />
                  <MenuItem Header="Delete all elements" Command="{Binding ClearElementsCommand}" IsVisible="{Binding IsBlock}" />
                  <MenuItem Header="Insert element before" Command="{Binding InsertBeforeCommand}" IsVisible="{Binding IsBlockElement}" />
                  <MenuItem Header="Duplicate element" Command="{Binding DuplicateElementCommand}" IsVisible="{Binding IsBlockElement}" />
                  <MenuItem Header="Delete element" Command="{Binding DeleteElementCommand}" IsVisible="{Binding IsBlockElement}" />
                  <MenuItem Header="Copy field path" Click="CopyPath_Click" />
                </ContextMenu>
              </Grid.ContextMenu>
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}">
                <Border Width="3" Height="16" Background="{StaticResource KWarning}" IsVisible="{Binding IsDirty}" />
                <TextBlock Text="{Binding DisplayText}" FontSize="12.5" VerticalAlignment="Center" Classes.section="{Binding IsContainer}" Classes.note="{Binding IsExplanation}" TextTrimming="CharacterEllipsis" />
              </StackPanel>

              <TextBox Grid.Column="1" Classes="value" Classes.dirty="{Binding IsDirty}" Classes.error="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                       IsVisible="{Binding IsTextEditor}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" KeyDown="ValueBox_KeyDown" ToolTip.Tip="{Binding Error}" />
              <ComboBox Grid.Column="1" Classes="value" IsVisible="{Binding IsEnum}" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedOption, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" IsVisible="{Binding IsReadOnlyValue}" Text="{Binding Value}" Foreground="{StaticResource KMuted}" FontFamily="{StaticResource KMono}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Grid.ColumnSpan="3" IsVisible="{Binding IsExplanation}" Text="{Binding Value}" Foreground="{StaticResource KFaint}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

              <TextBlock Grid.Column="2" Text="{Binding Units}" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
              <TextBlock Grid.Column="3" Text="{Binding Extra}" Foreground="{StaticResource KMuted}" FontSize="11.5" FontFamily="{StaticResource KMono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>
  </DockPanel>

  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{StaticResource KAccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
  </UserControl.Styles>
</UserControl>
