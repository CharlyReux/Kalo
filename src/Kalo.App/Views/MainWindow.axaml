<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:vm="using:Kalo.App.ViewModels"
        xmlns:views="using:Kalo.App.Views"
        xmlns:vp="using:Kalo.App.Viewport"
        xmlns:core="using:Kalo.Core"
        x:Class="Kalo.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Kalo"
        Icon="/Assets/kalo.ico"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        Background="{StaticResource KBg}">

  <Window.Resources>
    <FontFamily x:Key="KIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding PlayCommand}" />
    <KeyBinding Gesture="Ctrl+F5" Command="{Binding PlayFromCameraCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding StopGameCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- ===== Title and menu bar ===== -->
    <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource KPanel}" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,0">
        <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource KAccent}" VerticalAlignment="Center">
          <TextBlock Text="K" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Menu VerticalAlignment="Center" Margin="6,0,0,0">
          <MenuItem Header="_File">
            <MenuItem Header="Save" InputGesture="Ctrl+S" Command="{Binding SaveActiveCommand}" />
            <MenuItem Header="Refresh changes" Command="{Binding RefreshChangesCommand}" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="Project" Command="{Binding ShowExplorerCommand}" />
            <MenuItem Header="Changes" Command="{Binding ShowChangesCommand}" />
            <MenuItem Header="Activity" Command="{Binding ShowActivityCommand}" />
            <MenuItem Header="Log (raw output)" Command="{Binding ShowOutputCommand}" />
            <MenuItem Header="Problems" Command="{Binding ShowProblemsCommand}" />
          </MenuItem>
          <MenuItem Header="_Play">
            <MenuItem Header="Play (map and gametype chosen at the top)" InputGesture="F5" Command="{Binding PlayCommand}" />
            <MenuItem Header="Play from camera (open map: start where the editor camera is)" InputGesture="Ctrl+F5" Command="{Binding PlayFromCameraCommand}" />
            <MenuItem Header="Stop" InputGesture="Shift+F5" Command="{Binding StopGameCommand}" />
            <Separator />
            <MenuItem Header="Play in MCC (builds a real map: a few minutes; MCC with mods)" Command="{Binding PlayInMccCommand}" />
            <MenuItem Header="Stop the MCC build" Command="{Binding StopMccBuildCommand}" IsEnabled="{Binding IsBuildingForMcc}" />
            <MenuItem Header="Export the map as a Forge variant (vanilla MCC, no mods)" Command="{Binding ExportForgeVariantCommand}" />
          </MenuItem>
          <MenuItem Header="_Help">
            <MenuItem Header="Recipes: how to do common things" Click="Recipes_Click" />
            <Separator />
            <MenuItem Header="Kalo Script reference (gametypes and missions)" InputGesture="F1" Click="Docs_Click" />
            <MenuItem Header="Kalo Script: actions and conditions" Click="DocsReference_Click" />
          </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Play" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" FontSize="12" />
          <ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" Width="300" MinHeight="26" FontSize="12"
                    ToolTip.Tip="Map to play. Follows the map tab you are working in." />
          <TextBlock Text="with" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" FontSize="12" IsVisible="{Binding PlayIsMultiplayer}" />
          <ComboBox ItemsSource="{Binding GametypeChoices}" SelectedItem="{Binding SelectedGametype}" Width="200" MinHeight="26" FontSize="12" IsVisible="{Binding PlayIsMultiplayer}"
                    ToolTip.Tip="Gametype to play. 'Map default' plays the map as it is; your own gametypes are compiled and loaded first." />
          <!-- Campaign missions: no gametype; a difficulty and where the mission starts -->
          <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}" Width="104" MinHeight="26" FontSize="12" IsVisible="{Binding PlayIsCampaign}"
                    ToolTip.Tip="Campaign difficulty" />
          <ComboBox ItemsSource="{Binding InsertionChoices}" SelectedItem="{Binding SelectedInsertion}" Width="150" MinHeight="26" FontSize="12" IsVisible="{Binding PlayIsCampaign}"
                    ToolTip.Tip="Where the mission starts (its insertion point). What each one does is up to the mission's insertion script (e.g. m10_insertion): 0 is the beginning." />
          <ComboBox ItemsSource="{Binding PlayerChoices}" SelectedItem="{Binding SelectedPlayers}" Width="96" MinHeight="26" FontSize="12"
                    ToolTip.Tip="Local players, split-screen in one game window. Player 1 uses the keyboard and mouse (or the first gamepad); plug in gamepads for the others." />
          <CheckBox Content="Clean screen" IsChecked="{Binding CleanGameScreen}" FontSize="12" VerticalAlignment="Center"
                    ToolTip.Tip="Hides the engine's text and error markers drawn over the game (they stay in the Log panel). Remembered for next time; applies at once while the game runs." />
          <Button Classes="primary" Command="{Binding PlayCommand}" ToolTip.Tip="{Binding PlaySummary}" Padding="10,3">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE768;" VerticalAlignment="Center" />
              <TextBlock Text="Play" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding PlayInMccCommand}" ToolTip.Tip="{Binding PlayInMccSummary}" IsEnabled="{Binding !IsBuildingForMcc}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE7FC;" VerticalAlignment="Center" />
              <TextBlock Text="MCC" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding StopGameCommand}" ToolTip.Tip="Stop the game (Shift+F5)">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE71A;" Foreground="{StaticResource KError}" />
          </Button>
          <Border Width="1" Height="18" Background="{StaticResource KBorder}" Margin="4,0" />
          <Button Classes="tool" Click="Settings_Click" ToolTip.Tip="Settings: keys (QWERTY / AZERTY)">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE713;" />
          </Button>
        </StackPanel>
        <Border />
      </DockPanel>
    </Border>

    <!-- ===== Status bar ===== -->
    <Border DockPanel.Dock="Bottom" Height="24" Background="{StaticResource KPanel}" BorderBrush="{StaticResource KBorder}" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="7" Height="7" Fill="{Binding HostBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding HostStatus}" FontSize="11.5" Foreground="{StaticResource KMuted}" ToolTip.Tip="Kalo's Engine: Bungie's editing library (ManagedBlam), which reads and writes the game files for Kalo" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="7" Height="7" Fill="{Binding GameBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GameStatus}" FontSize="11.5" Foreground="{StaticResource KMuted}" />
          </StackPanel>
          <TextBlock Text="{Binding ChangesSummary}" FontSize="11.5" Foreground="{StaticResource KMuted}" />
          <TextBlock Text="{Binding IndexStatus}" FontSize="11.5" Foreground="{StaticResource KMuted}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{StaticResource KAccentText}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock FontSize="11.5" Foreground="{StaticResource KError}" Text="{Binding ErrorCount, StringFormat='✕ {0}'}" />
          <TextBlock FontSize="11.5" Foreground="{StaticResource KWarning}" Text="{Binding WarningCount, StringFormat='! {0}'}" />
          <TextBlock FontSize="11.5" Foreground="{StaticResource KMuted}" Text="{Binding WorkspaceText}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Body ===== -->
    <Grid ColumnDefinitions="44,280,4,*,4,290">

      <!-- Activity bar -->
      <Border Grid.Column="0" Background="{StaticResource KPanel}" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,6,0,0" Spacing="2">
          <Button Classes="activity" Classes.active="{Binding IsExplorer}" Command="{Binding ShowExplorerCommand}" ToolTip.Tip="Project">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE8B7;" FontSize="18" />
          </Button>
          <Button Classes="activity" Classes.active="{Binding IsChangesPanel}" Command="{Binding ShowChangesCommand}" ToolTip.Tip="What your mod changed (compared with the original game)">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE81C;" FontSize="18" />
          </Button>
          <Button Classes="activity" Classes.active="{Binding IsGametypesPanel}" Command="{Binding ShowGametypesCommand}" ToolTip.Tip="Gametype scripts">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE943;" FontSize="18" />
          </Button>
          <Button Classes="activity" Classes.active="{Binding IsProjectsPanel}" Command="{Binding ShowProjectsCommand}" ToolTip.Tip="Mod projects">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE7B8;" FontSize="18" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Side panel -->
      <Border Grid.Column="1" Background="{StaticResource KPanel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="34" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding SidePanelTitle}" Classes="header" Margin="10,0" VerticalAlignment="Center" />
          </Border>

          <!-- Project: My mod (default) or all game files (advanced) -->
          <DockPanel IsVisible="{Binding IsExplorer}">
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" Padding="6,5">
            <Border BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="seg" Content="My mod" IsChecked="{Binding IsModTab, Mode=OneWay}" Command="{Binding ShowModTabCommand}" />
                <ToggleButton Classes="seg" Content="All game files" IsChecked="{Binding IsAllFilesTab, Mode=OneWay}" Command="{Binding ShowAllFilesTabCommand}"
                              ToolTip.Tip="Every game file of Halo Reach (advanced; Bungie calls them tags). Open one and save it to add it to your mod." />
              </StackPanel>
            </Border>
          </Border>
          <Grid>
          <views:ModPanel IsVisible="{Binding IsModTab}" />
          <DockPanel IsVisible="{Binding IsAllFilesTab}">
            <TextBox DockPanel.Dock="Top" Classes="compact" Margin="6" Watermark="Search game files (e.g. assault weapon)" Text="{Binding SearchText}" x:Name="SearchBox" />
            <Grid>
              <TreeView x:Name="ExplorerTree" ItemsSource="{Binding ExplorerRoots}" IsVisible="{Binding NotSearching}" DoubleTapped="Explorer_DoubleTapped">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:ExplorerNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate DataType="vm:ExplorerNode" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="6" Height="22">
                      <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Dot}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                      <TextBlock Text="M" FontSize="11" Foreground="{StaticResource KWarning}" FontFamily="{StaticResource KMono}" IsVisible="{Binding IsChanged}" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" IsVisible="{Binding IsSearching}" Background="Transparent" DoubleTapped="Search_DoubleTapped" KeyDown="Search_KeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:SearchResult">
                    <StackPanel Spacing="0">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" />
                      <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource KMuted}" FontFamily="{StaticResource KMono}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </DockPanel>

          </Grid>
          </DockPanel>

          <!-- Gametype scripts -->
          <DockPanel IsVisible="{Binding IsGametypesPanel}">
            <TextBlock DockPanel.Dock="Top" Margin="10,8" TextWrapping="Wrap" Foreground="{StaticResource KMuted}" FontSize="12"
                       Text="Megalo scripts from data\multiplayer\megalo. Double-click to edit; F7 compiles." />
            <ListBox x:Name="ScriptList" ItemsSource="{Binding Scripts}" Background="Transparent" DoubleTapped="Scripts_DoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ScriptFile">
                  <StackPanel Spacing="0">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" />
                    <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource KMuted}" FontFamily="{StaticResource KMono}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Mod projects -->
          <views:ProjectsPanel IsVisible="{Binding IsProjectsPanel}" />

          <!-- Changes (the project overlay) -->
          <DockPanel IsVisible="{Binding IsChangesPanel}">
            <StackPanel DockPanel.Dock="Top" Margin="10,8" Spacing="6">
              <TextBlock Text="{Binding ChangesSummary}" Foreground="{StaticResource KMuted}" FontSize="12" />
              <Button Classes="outline" Content="Refresh" Command="{Binding RefreshChangesCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Changes}" Background="Transparent" DoubleTapped="Changes_DoubleTapped" x:Name="ChangesList">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ChangeItem">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="tool" Content="Revert" FontSize="11.5"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RevertChangeCommand}" CommandParameter="{Binding}" />
                    <Button DockPanel.Dock="Right" Classes="tool" Content="Diff" FontSize="11.5" ToolTip.Tip="Compare with the original game file"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CompareChangeCommand}" CommandParameter="{Binding}" />
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource KWarning}" />
                        <TextBlock Text="{Binding Name}" FontSize="12.5" />
                      </StackPanel>
                      <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource KMuted}" FontFamily="{StaticResource KMono}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="2" Background="{StaticResource KBorder}" ResizeDirection="Columns" />

      <!-- Center: tabs, editor, bottom panel -->
      <Grid Grid.Column="3" RowDefinitions="*,4,210">

        <!-- Editor groups: one, or two split side by side / top and bottom (the second can also be its own window) -->
        <Grid x:Name="EditorArea" Grid.Row="0">
          <views:EditorGroupView x:Name="PrimaryGroupView" DataContext="{Binding Primary}" />
          <GridSplitter x:Name="EditorSplitter" Background="{StaticResource KBorder}" IsVisible="False" />
          <views:EditorGroupView x:Name="SecondaryGroupView" IsVisible="False" />
        </Grid>

        <GridSplitter Grid.Row="1" Background="{StaticResource KBorder}" ResizeDirection="Rows" />

        <!-- Bottom tool window -->
        <DockPanel Grid.Row="2" Background="{StaticResource KBg}">
          <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource KPanel}" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel Orientation="Horizontal" Margin="4,0">
                <Button Classes="tool" Content="Activity" Command="{Binding ShowActivityCommand}" Classes.selected="{Binding IsActivity}"
                        ToolTip.Tip="What Kalo and the game did, in plain words" />
                <Button Classes="tool" Command="{Binding ShowProblemsCommand}" Classes.selected="{Binding IsProblems}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Problems" />
                    <TextBlock Text="{Binding ErrorCount}" Foreground="{StaticResource KError}" />
                    <TextBlock Text="{Binding WarningCount}" Foreground="{StaticResource KWarning}" />
                  </StackPanel>
                </Button>
                <Button Classes="tool" Content="Objects" Command="{Binding ShowObjectsCommand}" Classes.selected="{Binding IsObjects}"
                        ToolTip.Tip="Every object you can place, with a 3D preview" />
                <Button Classes="tool" Content="Prefabs" Command="{Binding ShowPrefabsCommand}" Classes.selected="{Binding IsPrefabs}"
                        ToolTip.Tip="Groups of objects saved with your mod" />
                <Button Classes="tool" Content="Log" Command="{Binding ShowOutputCommand}" Classes.selected="{Binding IsOutput}"
                        ToolTip.Tip="Every raw line from Kalo, the Engine helper and the game (for troubleshooting)" />
              </StackPanel>
              <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Classes="tool" Content="Clear" Command="{Binding ClearOutputCommand}" Margin="0,0,6,0"
                      IsVisible="{Binding IsOutput}" />
              <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Classes="tool" Content="Clear" Command="{Binding ClearOutputCommand}" Margin="0,0,6,0"
                      IsVisible="{Binding IsActivity}" />
              <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,0,6,0" IsVisible="{Binding IsOutput}">
                <TextBlock Text="{Binding OutputFilterSummary}" VerticalAlignment="Center" Foreground="{StaticResource KMuted}" />
                <TextBox x:Name="OutputSearch" Width="240" Height="24" MinHeight="24" Padding="6,2" VerticalContentAlignment="Center"
                         Text="{Binding OutputFilter}" Watermark="Search the log (e.g. megalotrace)" KeyDown="OutputSearch_KeyDown"
                         ToolTip.Tip="Shows only the lines containing every word typed (any case). Esc clears it." />
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid>
            <ListBox x:Name="ActivityList" ItemsSource="{Binding Activity}" IsVisible="{Binding IsActivity}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ActivityItem">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="56" Text="{Binding Time}" Foreground="{StaticResource KFaint}" FontSize="11" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock DockPanel.Dock="Left" Width="18" Text="✕" Foreground="{StaticResource KError}" IsVisible="{Binding IsError}" />
                    <TextBlock DockPanel.Dock="Left" Width="18" Text="!" Foreground="{StaticResource KWarning}" IsVisible="{Binding IsWarning}" />
                    <TextBlock DockPanel.Dock="Left" Width="18" Text="✓" Foreground="LimeGreen" IsVisible="{Binding IsOk}" />
                    <TextBlock DockPanel.Dock="Left" Width="18" Text="·" Foreground="{StaticResource KFaint}" IsVisible="{Binding IsInfo}" />
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="MinHeight" Value="20" />
                  <Setter Property="Padding" Value="10,1" />
                </Style>
              </ListBox.Styles>
            </ListBox>
            <ListBox x:Name="OutputList" ItemsSource="{Binding VisibleOutput}" IsVisible="{Binding IsOutput}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Text="{Binding}" Classes="mono" Foreground="{StaticResource KCode}" TextWrapping="NoWrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="MinHeight" Value="18" />
                  <Setter Property="Padding" Value="10,0" />
                </Style>
              </ListBox.Styles>
            </ListBox>
            <!-- Object browser: categories | objects | preview -->
            <Grid ColumnDefinitions="190,*,300" IsVisible="{Binding IsObjects}">
              <DockPanel Grid.Column="0" Background="{StaticResource KPanelAlt}">
                <TextBox DockPanel.Dock="Top" Classes="compact" Margin="6" Watermark="Search any name" Text="{Binding ObjectFilter}" ToolTip.Tip="Finds objects by file name, Forge menu name (Flag Stand) or script name (stand)" />
                <ListBox ItemsSource="{Binding ObjectCategories}" SelectedItem="{Binding SelectedObjectCategory}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ObjectCategory">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource KFaint}" FontSize="11" />
                        <TextBlock Text="{Binding Title}" FontSize="12.5" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
              <ListBox x:Name="ObjectList" Grid.Column="1" ItemsSource="{Binding ObjectResults}" SelectedItem="{Binding SelectedObject}" Background="Transparent"
                       DoubleTapped="ObjectList_DoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ObjectEntry">
                    <DockPanel Background="Transparent" ToolTip.Tip="{Binding Tip}">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ScriptLabel}" IsVisible="{Binding HasScriptName}" Classes="mono" Foreground="{StaticResource KCode}" FontSize="11" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Kind}" Foreground="{StaticResource KFaint}" FontSize="11" />
                      </StackPanel>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" />
                          <TextBlock Text="{Binding ForgeName}" IsVisible="{Binding HasForgeName}" FontSize="12" Foreground="{StaticResource KMuted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Folder}" FontSize="10.5" Foreground="{StaticResource KFaint}" Classes="mono" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <DockPanel Grid.Column="2" Background="{StaticResource KPanelAlt}">
                <DockPanel DockPanel.Dock="Bottom" Margin="8,6">
                  <Button DockPanel.Dock="Right" Classes="primary" Content="Add to map" Command="{Binding AddSelectedObjectCommand}" IsEnabled="{Binding HasMap}" />
                  <TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>
                <vp:ModelPreview />
              </DockPanel>
            </Grid>

            <!-- Prefabs of the active mod -->
            <DockPanel IsVisible="{Binding IsPrefabs}">
              <Border DockPanel.Dock="Top" Padding="10,6">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KMuted}"
                           Text="A prefab is a group of objects saved with your mod. In a map, select objects, right-click the object list, Create prefab. Then place it anywhere (in front of the camera)." />
              </Border>
              <ListBox ItemsSource="{Binding Prefabs}" SelectedItem="{Binding SelectedPrefab}" Background="Transparent" DoubleTapped="Prefab_DoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:Prefab">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <Button Classes="outline" Content="Place" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlacePrefabCommand}" CommandParameter="{Binding}" />
                        <Button Classes="tool" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeletePrefabCommand}" CommandParameter="{Binding}" ToolTip.Tip="Delete this prefab">
                          <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE74D;" />
                        </Button>
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource KMuted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <ListBox ItemsSource="{Binding Problems}" IsVisible="{Binding IsProblems}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ProblemItem">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="18" Text="✕" Foreground="{StaticResource KError}" IsVisible="{Binding IsError}" />
                    <TextBlock DockPanel.Dock="Left" Width="18" Text="!" Foreground="{StaticResource KWarning}" IsVisible="{Binding !IsError}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource KFaint}" Margin="12,0,0,0" />
                    <StackPanel>
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Source}" Classes="mono" Foreground="{StaticResource KMuted}" FontSize="11" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="4" Background="{StaticResource KBorder}" ResizeDirection="Columns" />

      <!-- Inspector -->
      <Border Grid.Column="5" Background="{StaticResource KPanel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="34" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding InspectorTitle}" Classes="header" Margin="10,0" VerticalAlignment="Center" />
          </Border>
          <ScrollViewer>
            <StackPanel Margin="12,10" Spacing="10">

              <!-- Map: selected object and adding objects -->
              <StackPanel Spacing="8" IsVisible="{Binding HasMap}">
                <TextBlock Text="Click an object in the map or the list." Foreground="{StaticResource KMuted}" TextWrapping="Wrap"
                           IsVisible="{Binding !ActiveMap.HasSelection, FallbackValue=False}" />
                <StackPanel Spacing="8" IsVisible="{Binding ActiveMap.HasSelection, FallbackValue=False}">
                  <TextBlock Text="{Binding ActiveMap.Selected.Display, FallbackValue=''}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                  <Border Background="{StaticResource KSelection}" CornerRadius="4" Padding="8,6" IsVisible="{Binding ActiveMap.HasMultiSelection, FallbackValue=False}">
                    <TextBlock Text="{Binding ActiveMap.SelectionText, FallbackValue=''}" TextWrapping="Wrap" FontSize="12" />
                  </Border>
                  <TextBlock Text="{Binding ActiveMap.Selected.Detail, FallbackValue=''}" Foreground="{StaticResource KMuted}" FontFamily="{StaticResource KMono}" FontSize="11.5" />
                  <SelectableTextBlock Text="{Binding ActiveMap.Selected.Tag, FallbackValue=''}" FontFamily="{StaticResource KMono}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource KCode}" />
                  <DockPanel IsVisible="{Binding !ActiveMap.HasMultiSelection, FallbackValue=False}">
                    <TextBlock Text="Name" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Width="46" />
                    <TextBox Classes="compact" MaxLength="31" Watermark="no name (e.g. hill_1, red_goal)"
                             Text="{Binding ActiveMap.Selected.NameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                             ToolTip.Tip="A name for this object, shown in the object list (F2 there). Saved in the map as Sapien's object name; gametype scripts find objects by their Megalo label instead." />
                  </DockPanel>
                  <TextBlock Text="POSITION (world units)" Classes="header" Margin="0,6,0,0" />
                  <Grid ColumnDefinitions="18,*,18,*,18,*" Margin="0,2,0,0">
                    <TextBlock Text="x" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Classes="compact mono" Text="{Binding ActiveMap.Selected.X, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" views:NumberDrag.Step="0.1" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="2" Text="y" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Classes="compact mono" Text="{Binding ActiveMap.Selected.Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" views:NumberDrag.Step="0.1" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="4" Text="z" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="5" Classes="compact mono" Text="{Binding ActiveMap.Selected.Z, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" views:NumberDrag.Step="0.1" />
                  </Grid>
                  <TextBlock Text="ROTATION (degrees)" Classes="header" Margin="0,6,0,0" />
                  <Grid ColumnDefinitions="28,*,28,*,28,*" Margin="0,2,0,0">
                    <TextBlock Text="yaw" Foreground="{StaticResource KMuted}" FontSize="11" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Classes="compact mono" Text="{Binding ActiveMap.Selected.YawText, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" views:NumberDrag.Step="1" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="2" Text="pitch" Foreground="{StaticResource KMuted}" FontSize="11" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Classes="compact mono" Text="{Binding ActiveMap.Selected.PitchText, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" views:NumberDrag.Step="1" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="4" Text="roll" Foreground="{StaticResource KMuted}" FontSize="11" VerticalAlignment="Center" />
                    <TextBox Grid.Column="5" Classes="compact mono" Text="{Binding ActiveMap.Selected.RollText, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" views:NumberDrag.Step="1" />
                  </Grid>
                  <WrapPanel Margin="0,4,0,0">
                    <Button Classes="outline" Content="Frame" Margin="0,0,6,6" Command="{Binding ActiveMap.FocusSelectedCommand, FallbackValue={x:Null}}" />
                    <Button Classes="outline" Content="Duplicate" Margin="0,0,6,6" Command="{Binding ActiveMap.DuplicateSelectedCommand, FallbackValue={x:Null}}" />
                    <Button Classes="outline" Content="Delete" Margin="0,0,6,6" Command="{Binding ActiveMap.DeleteSelectedCommand, FallbackValue={x:Null}}" />
                    <Button Classes="outline" Content="Copy" Margin="0,0,6,6" Command="{Binding ActiveMap.CopySelectionCommand, FallbackValue={x:Null}}" />
                  </WrapPanel>
                  <!-- Campaign markers: what they are, and a box volume's size -->
                  <StackPanel Spacing="6" IsVisible="{Binding ActiveMap.Selected.IsCampaignMarker, FallbackValue=False}">
                    <TextBlock Text="{Binding ActiveMap.Selected.Purpose, FallbackValue=''}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                               IsVisible="{Binding ActiveMap.Selected.HasPurpose, FallbackValue=False}" />
                    <TextBlock Text="{Binding ActiveMap.Selected.MarkerHelp, FallbackValue=''}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource KMuted}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsVisible="{Binding ActiveMap.Selected.IsBoxVolume, FallbackValue=False}">
                      <TextBlock Text="W" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Width (along its forward direction)" />
                      <TextBox Grid.Column="1" Classes="compact mono" Margin="0,0,6,0" views:NumberDrag.Step="0.25" views:NumberDrag.Minimum="0.05"
                               Text="{Binding ActiveMap.Selected.VolumeWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                      <TextBlock Grid.Column="2" Text="L" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Length (sideways)" />
                      <TextBox Grid.Column="3" Classes="compact mono" Margin="0,0,6,0" views:NumberDrag.Step="0.25" views:NumberDrag.Minimum="0.05"
                               Text="{Binding ActiveMap.Selected.VolumeLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                      <TextBlock Grid.Column="4" Text="H" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Height" />
                      <TextBox Grid.Column="5" Classes="compact mono" views:NumberDrag.Step="0.25" views:NumberDrag.Minimum="0.05"
                               Text="{Binding ActiveMap.Selected.VolumeHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                    </Grid>
                    <!-- Trigger volumes: Kalo writes the mission script code -->
                    <Border BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,4,0,0"
                            IsVisible="{Binding ActiveMap.Selected.IsVolume, FallbackValue=False}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="When the player enters" FontSize="11.5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding ActiveMap.VolumeActionChoices, FallbackValue={x:Null}}" SelectedItem="{Binding ActiveMap.VolumeAction, FallbackValue={x:Null}}"
                                  PlaceholderText="Pick what happens…" HorizontalAlignment="Stretch" FontSize="12" MinHeight="24" />
                        <DockPanel IsVisible="{Binding ActiveMap.VolumeActionHasParam, FallbackValue=False}">
                          <TextBlock Text="{Binding ActiveMap.VolumeParamLabel, FallbackValue=''}" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <ComboBox ItemsSource="{Binding ActiveMap.VolumeParamChoices, FallbackValue={x:Null}}" SelectedItem="{Binding ActiveMap.VolumeParam, FallbackValue={x:Null}}"
                                    HorizontalAlignment="Stretch" FontSize="12" MinHeight="24" />
                        </DockPanel>
                        <Button Classes="outline" Content="Add to mission script" Command="{Binding ActiveMap.AddVolumeTriggerCommand, FallbackValue={x:Null}}" HorizontalAlignment="Left"
                                ToolTip.Tip="Writes the code into the mission's own script (it opens), and names the volume if it has no name" />
                        <TextBlock Text="{Binding ActiveMap.VolumeTriggerStatus, FallbackValue=''}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KMuted}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <!-- Campaign AI: the squad of the selected spawn point(s): what spawns -->
                  <!-- Campaign: a squad patrols a path of script points -->
                  <Border BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                          IsVisible="{Binding ActiveMap.ShowPatrol, FallbackValue=False}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="PATROL" Classes="header" />
                      <TextBlock Text="A squad walks a path of points until it sees an enemy." FontSize="11" Foreground="{StaticResource KMuted}" TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="50,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Squad" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ActiveMap.PatrolSquadChoices, FallbackValue={x:Null}}" SelectedItem="{Binding ActiveMap.PatrolSquad, FallbackValue={x:Null}}"
                                  HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24" />
                        <TextBlock Grid.Row="1" Text="Path" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,4,0,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ActiveMap.PatrolPathChoices, FallbackValue={x:Null}}" SelectedItem="{Binding ActiveMap.PatrolPath, FallbackValue={x:Null}}"
                                  HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24" Margin="0,4,0,0" ToolTip.Tip="A point set: its points in order are the path" />
                      </Grid>
                      <WrapPanel>
                        <Button Classes="outline" Content="New path here" Command="{Binding ActiveMap.NewPatrolPathCommand, FallbackValue={x:Null}}" Margin="0,0,4,4"
                                ToolTip.Tip="A new point set with its first point where the view is aimed" />
                        <Button Classes="outline" Content="Add point here" Command="{Binding ActiveMap.AddPatrolPointCommand, FallbackValue={x:Null}}" Margin="0,0,4,4"
                                ToolTip.Tip="The path's next point, where the view is aimed" />
                      </WrapPanel>
                      <CheckBox Content="Walk (not run)" IsChecked="{Binding ActiveMap.PatrolWalk, FallbackValue=True}" FontSize="11.5" />
                      <Button Classes="outline" Content="Add patrol to mission script" Command="{Binding ActiveMap.AddPatrolCommand, FallbackValue={x:Null}}" HorizontalAlignment="Left"
                              ToolTip.Tip="Writes a command script that walks the path in a loop and gives it to the squad once it is in the game" />
                      <TextBlock Text="{Binding ActiveMap.PatrolStatus, FallbackValue=''}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KMuted}" />
                    </StackPanel>
                  </Border>
                  <ContentControl Content="{Binding ActiveMap.SquadEditor, FallbackValue={x:Null}}" IsVisible="{Binding ActiveMap.HasSquadEditor, FallbackValue=False}">
                   <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:SquadEditorViewModel">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title, FallbackValue=''}" Classes="header" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding About, FallbackValue=''}" FontSize="11.5" Foreground="{StaticResource KMuted}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PlacedBy, FallbackValue=''}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasPlacedBy, FallbackValue=False}" />
                    <TextBlock Text="{Binding Starts, FallbackValue=''}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding HasStarts, FallbackValue=False}" />
                    <Grid ColumnDefinitions="70,*">
                      <TextBlock Text="Team" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding TeamChoices, FallbackValue={x:Null}}" SelectedIndex="{Binding TeamIndex, FallbackValue=-1}" HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24"
                                ToolTip.Tip="Who it fights. Human squads are on the player's side and fight the Covenant." />
                    </Grid>
                    <!-- The selected point's own character and weapon -->
                    <ContentControl Content="{Binding Point}" IsVisible="{Binding HasPoint}">
                     <ContentControl.ContentTemplate>
                      <DataTemplate DataType="vm:SquadPointRow">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title, FallbackValue=''}" Classes="header" Margin="0,4,0,0" />
                      <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Character" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CharacterOptions, FallbackValue={x:Null}}" SelectedIndex="{Binding CharacterIndex, FallbackValue=-1}"
                                  HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24" Margin="0,0,0,4"
                                  ToolTip.Tip="What spawns at this point. From its cell: the character of the squad's cell below." />
                        <TextBlock Grid.Row="1" Text="Weapon" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WeaponOptions, FallbackValue={x:Null}}" SelectedIndex="{Binding WeaponIndex, FallbackValue=-1}"
                                  HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24"
                                  ToolTip.Tip="The weapon it spawns with. From its cell: the cell's weapon below." />
                      </Grid>
                      <TextBlock Text="{Binding CellText, FallbackValue=''}" FontSize="11" Foreground="{StaticResource KFaint}" />
                    </StackPanel>
                      </DataTemplate>
                     </ContentControl.ContentTemplate>
                    </ContentControl>
                    <!-- The squad's cells -->
                    <TextBlock Text="CELLS (WHAT THE SQUAD SPAWNS)" Classes="header" Margin="0,4,0,0" IsVisible="{Binding HasCells, FallbackValue=False}" />
                    <TextBlock Text="{Binding TemplateNote, FallbackValue=''}" FontSize="11" Foreground="{StaticResource KWarning}" TextWrapping="Wrap"
                               IsVisible="{Binding HasTemplateNote, FallbackValue=False}" />
                    <Button Classes="outline" Content="{Binding TemplateButton, FallbackValue=''}" IsVisible="{Binding HasTemplate, FallbackValue=False}" HorizontalAlignment="Left"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveMap.OpenSquadTemplateCommand, FallbackValue={x:Null}}"
                            ToolTip.Tip="Open the squad template in the field editor. It is shared: every squad (in every mission of your mod) made from it changes. Save keeps a copy in your mod." />
                    <Button Classes="outline" Content="Use its own cells" IsVisible="{Binding IsTemplated, FallbackValue=False}" HorizontalAlignment="Left"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveMap.DetachSquadCommand, FallbackValue={x:Null}}"
                            ToolTip.Tip="Detach the squad from its template: it gets a copy of the template's cells as its own, and then these cells decide what spawns (editable here)" />
                    <ItemsControl ItemsSource="{Binding Cells, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SquadCellRow">
                          <Border BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel Spacing="4">
                              <DockPanel>
                                <TextBox DockPanel.Dock="Right" Classes="compact mono" Width="52" views:NumberDrag.Step="1" views:NumberDrag.Minimum="0" IsEnabled="{Binding CanEdit}"
                                         Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="How many spawn from this cell (normal difficulty count)" />
                                <TextBlock DockPanel.Dock="Right" Text="count" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              </DockPanel>
                              <Grid ColumnDefinitions="70,*" Margin="0,0,0,3" IsVisible="{Binding HasVehicleField}">
                                <TextBlock Text="Vehicle" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding VehicleChoices}" SelectedIndex="{Binding Vehicle}" HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24" IsEnabled="{Binding CanEdit}"
                                          ToolTip.Tip="The cell's AI spawn in this vehicle (the first one drives). The list is the mission's vehicle palette: open a vehicle and Use it › Add to map palette to add one." />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding Characters}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:SquadChoiceRow">
                                    <Grid ColumnDefinitions="70,*,Auto" Margin="0,0,0,3">
                                      <TextBlock Text="Character" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                                      <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24" IsEnabled="{Binding CanEdit}" />
                                      <TextBox Grid.Column="2" Classes="compact mono" Width="40" Margin="4,0,0,0" Text="{Binding Chance, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEdit}"
                                               IsVisible="{Binding $parent[ItemsControl].((vm:SquadCellRow)DataContext).ShowChances, FallbackValue=False}" ToolTip.Tip="Chance (weight) of this entry" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="No character in this cell." FontSize="11" Foreground="{StaticResource KFaint}" IsVisible="{Binding HasNoCharacter}" />
                              <ItemsControl ItemsSource="{Binding Weapons}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:SquadChoiceRow">
                                    <Grid ColumnDefinitions="70,*,Auto" Margin="0,0,0,3">
                                      <TextBlock Text="Weapon" FontSize="11.5" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" />
                                      <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24" IsEnabled="{Binding CanEdit}" />
                                      <TextBox Grid.Column="2" Classes="compact mono" Width="40" Margin="4,0,0,0" Text="{Binding Chance, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEdit}"
                                               IsVisible="{Binding $parent[ItemsControl].((vm:SquadCellRow)DataContext).ShowChances, FallbackValue=False}" ToolTip.Tip="Chance (weight) of this entry" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="No weapon set: the character's default." FontSize="11" Foreground="{StaticResource KFaint}" IsVisible="{Binding HasNoWeapon}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel>
                      <Button DockPanel.Dock="Left" Classes="outline" Content="New squad here" Margin="0,0,6,0"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveMap.NewSquadHereCommand, FallbackValue={x:Null}}"
                              ToolTip.Tip="A new squad like this one (same team, group, zone and objective) with its own cells and one spawn point in front of the camera. Scripts place it with ai_place(name)." />
                      <Button DockPanel.Dock="Left" Classes="outline" Content="All squad fields…" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveMap.OpenSquadFieldsCommand, FallbackValue={x:Null}}"
                              ToolTip.Tip="This squad alone in a field editor tab: team, initial zone and objective, spawn points, everything" />
                      <TextBlock Text="{Binding PointsText, FallbackValue=''}" FontSize="11" Foreground="{StaticResource KFaint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Error, FallbackValue=''}" Foreground="{StaticResource KError}" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                  </StackPanel>
                    </DataTemplate>
                   </ContentControl.ContentTemplate>
                  </ContentControl>
                  <!-- Campaign: lines of the mission's scripts that name the selection -->
                  <StackPanel Spacing="4" IsVisible="{Binding ActiveMap.HasScriptUses, FallbackValue=False}">
                    <TextBlock Text="USED BY SCRIPTS" Classes="header" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ActiveMap.ScriptUsesText, FallbackValue=''}" FontSize="11.5" Foreground="{StaticResource KMuted}" TextWrapping="Wrap"
                               IsVisible="{Binding ActiveMap.ScriptUsesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                    <ItemsControl ItemsSource="{Binding ActiveMap.ScriptUses, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ScriptUse">
                          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2" Margin="0,0,0,2"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActiveMap.OpenScriptUseCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                                  ToolTip.Tip="Open the script at this line">
                            <StackPanel Spacing="0">
                              <TextBlock Text="{Binding Where}" FontSize="10.5" Foreground="{StaticResource KMuted}" FontFamily="{StaticResource KMono}" />
                              <TextBlock Text="{Binding Text}" FontSize="11.5" FontFamily="{StaticResource KMono}" Foreground="{StaticResource KCode}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding ActiveMap.Selected.IsObject, FallbackValue=False}">
                  <DockPanel>
                    <TextBlock Text="Scale" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Width="46" />
                    <Button DockPanel.Dock="Right" Classes="tool" Content="Set" Command="{Binding ActiveMap.SetScaleCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding #ScaleBox.Text}" />
                    <TextBox x:Name="ScaleBox" Classes="compact mono" Text="{Binding ActiveMap.Selected.ScaleText, Mode=OneWay, FallbackValue=''}" Margin="0,0,4,0"
                             views:NumberDrag.Step="0.05" views:NumberDrag.Minimum="0.01" LostFocus="ScaleBox_LostFocus"
                             ToolTip.Tip="Size multiplier (1 = normal). Press Set to apply it to every selected object." />
                  </DockPanel>
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KWarning}"
                             Text="Reach ignores this scale in multiplayer games: objects spawn at normal size (it only shows here). To scale in game, use object_set_scale in the gametype script." />
                  <!-- Objective zone (multiplayer boundary): hills, territories, capture and kill zones -->
                  <StackPanel Spacing="4" Margin="0,4,0,0">
                    <DockPanel>
                      <TextBlock Text="Zone" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Width="46" />
                      <ComboBox SelectedIndex="{Binding ActiveMap.Selected.ZoneShapeIndex, FallbackValue=0}" HorizontalAlignment="Stretch" FontSize="12" MinHeight="24"
                                ToolTip.Tip="The object's area for gametypes: hills, territories, capture and kill zones (drawn in the map view)">
                        <ComboBoxItem Content="None" />
                        <ComboBoxItem Content="Sphere" />
                        <ComboBoxItem Content="Cylinder" />
                        <ComboBoxItem Content="Box" />
                      </ComboBox>
                    </DockPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding ActiveMap.Selected.HasZone, FallbackValue=False}">
                      <TextBlock Text="{Binding ActiveMap.Selected.ZoneWidthLabel, FallbackValue='Radius'}" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Grid.Column="1" Classes="compact mono" Margin="0,0,6,4" views:NumberDrag.Step="0.25" views:NumberDrag.Minimum="0"
                               Text="{Binding ActiveMap.Selected.ZoneWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                      <TextBlock Grid.Column="2" Text="Length" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,6,0"
                                 IsVisible="{Binding ActiveMap.Selected.IsBoxZone, FallbackValue=False}" />
                      <TextBox Grid.Column="3" Classes="compact mono" Margin="0,0,0,4" views:NumberDrag.Step="0.25" views:NumberDrag.Minimum="0"
                               IsVisible="{Binding ActiveMap.Selected.IsBoxZone, FallbackValue=False}"
                               Text="{Binding ActiveMap.Selected.ZoneLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                      <TextBlock Grid.Row="1" Text="Up" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,6,0"
                                 IsVisible="{Binding !ActiveMap.Selected.IsSphereZone, FallbackValue=False}" />
                      <TextBox Grid.Row="1" Grid.Column="1" Classes="compact mono" Margin="0,0,6,0" views:NumberDrag.Step="0.25" views:NumberDrag.Minimum="0"
                               IsVisible="{Binding !ActiveMap.Selected.IsSphereZone, FallbackValue=False}" ToolTip.Tip="Height above the object"
                               Text="{Binding ActiveMap.Selected.ZoneTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="Down" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,6,0"
                                 IsVisible="{Binding !ActiveMap.Selected.IsSphereZone, FallbackValue=False}" />
                      <TextBox Grid.Row="1" Grid.Column="3" Classes="compact mono" views:NumberDrag.Step="0.25" views:NumberDrag.Minimum="0"
                               IsVisible="{Binding !ActiveMap.Selected.IsSphereZone, FallbackValue=False}" ToolTip.Tip="Depth below the object"
                               Text="{Binding ActiveMap.Selected.ZoneBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                    </Grid>
                    <!-- When a player enters: Kalo writes the gametype code -->
                    <Border BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                      <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="ActiveMap.Selected.HasZone" FallbackValue="False" />
                          <Binding Path="!ActiveMap.IsCampaign" FallbackValue="False" />
                        </MultiBinding>
                      </Border.IsVisible>
                      <StackPanel Spacing="4">
                        <TextBlock Text="When a player enters" FontSize="11.5" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding ActiveMap.ZoneActionChoices, FallbackValue={x:Null}}" SelectedItem="{Binding ActiveMap.ZoneAction, FallbackValue={x:Null}}"
                                  PlaceholderText="Pick what happens…" HorizontalAlignment="Stretch" FontSize="12" MinHeight="24" />
                        <DockPanel IsVisible="{Binding ActiveMap.ZoneActionHasParam, FallbackValue=False}">
                          <TextBlock Text="{Binding ActiveMap.ZoneParamLabel, FallbackValue=''}" FontSize="11" Foreground="{StaticResource KMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBox Classes="compact mono" Text="{Binding ActiveMap.ZoneParam, Mode=TwoWay, FallbackValue=''}" />
                        </DockPanel>
                        <Button Classes="outline" Content="Add to gametype" Command="{Binding ActiveMap.AddZoneTriggerCommand, FallbackValue={x:Null}}" HorizontalAlignment="Left"
                                ToolTip.Tip="Writes the code into the gametype picked for Play (or a new one made from Slayer), and gives this object a Megalo label if it has none" />
                        <TextBlock Text="{Binding ActiveMap.ZoneTriggerStatus, FallbackValue=''}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KMuted}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  </StackPanel>
                  <!-- Every other property of this object, as saved in the map -->
                  <StackPanel Spacing="4" IsVisible="{Binding ActiveMap.HasProperties, FallbackValue=False}">
                    <TextBlock Text="PROPERTIES" Classes="header" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding ActiveMap.Properties, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyRow">
                          <StackPanel Spacing="1" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Classes="header" Margin="0,8,0,0" IsVisible="{Binding IsHeader}" />
                            <Grid ColumnDefinitions="110,*" IsVisible="{Binding !IsHeader}">
                              <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource KMuted}" TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" ToolTip.Tip="{Binding Description}" />
                              <TextBox Grid.Column="1" Classes="compact mono" IsVisible="{Binding IsText}" views:NumberDrag.Step="1"
                                       Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                              <ComboBox Grid.Column="1" IsVisible="{Binding IsEnum}" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedOption}"
                                        HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="24" />
                            </Grid>
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource KError}" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>

                <TextBlock Text="ADD AN OBJECT" Classes="header" Margin="0,10,0,0" />
                <TextBlock Text="Open the Objects tab (bottom) to browse every object with a preview, or use the block tools on the left of the map. New objects go on the surface in front of the camera." Foreground="{StaticResource KMuted}" FontSize="12" TextWrapping="Wrap" />
                <Button Classes="outline" Content="Browse objects…" HorizontalAlignment="Left" Command="{Binding ShowObjectsCommand}" />
                <TextBlock Text="Or pick one already used in this map:" Foreground="{StaticResource KMuted}" FontSize="12" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding ActiveMap.PaletteChoices, FallbackValue={x:Null}}" SelectedItem="{Binding ActiveMap.SelectedPalette, FallbackValue={x:Null}}" HorizontalAlignment="Stretch" FontSize="12">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:PaletteChoice">
                      <TextBlock Text="{Binding Display}" FontSize="12" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="primary" Content="Add" HorizontalAlignment="Left" Command="{Binding ActiveMap.AddObjectCommand, FallbackValue={x:Null}}" />
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding HasTab}">
              <TextBlock Text="Select a field to see what it does." Foreground="{StaticResource KMuted}" TextWrapping="Wrap"
                         IsVisible="{Binding ActiveTab.SelectedField, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}" />
              <StackPanel Spacing="8" IsVisible="{Binding ActiveTab.SelectedField, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <TextBlock Text="{Binding ActiveTab.SelectedField.Label}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ActiveTab.SelectedField.Description}" TextWrapping="Wrap" Foreground="{StaticResource KCode}" />
                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                  <TextBlock Grid.Row="0" Text="Value" Foreground="{StaticResource KMuted}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveTab.SelectedField.Value}" Classes="mono" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Saved" Foreground="{StaticResource KMuted}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveTab.SelectedField.SavedValue}" Classes="mono" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Text="Units" Foreground="{StaticResource KMuted}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveTab.SelectedField.Units}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Range" Foreground="{StaticResource KMuted}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ActiveTab.SelectedField.Range}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="4" Text="Type" Foreground="{StaticResource KMuted}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActiveTab.SelectedField.Type}" Classes="mono" />
                  <TextBlock Grid.Row="5" Text="Raw name" Foreground="{StaticResource KMuted}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ActiveTab.SelectedField.RawName}" Classes="mono" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="PATH" Classes="header" Margin="0,6,0,0" />
                <SelectableTextBlock Text="{Binding ActiveTab.SelectedField.Path}" FontFamily="{StaticResource KMono}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource KCode}" />
                <TextBlock Text="{Binding ActiveTab.SelectedField.Error}" Foreground="{StaticResource KError}" TextWrapping="Wrap" />

                <!-- Block: add / clear -->
                <StackPanel Spacing="6" IsVisible="{Binding ActiveTab.SelectedField.IsBlock, FallbackValue=False}">
                  <TextBlock Text="BLOCK" Classes="header" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding ActiveTab.SelectedField.Value}" Foreground="{StaticResource KMuted}" />
                  <TextBlock Text="{Binding ActiveTab.SelectedField.TruncatedText}" Foreground="{StaticResource KWarning}" TextWrapping="Wrap" IsVisible="{Binding ActiveTab.SelectedField.IsTruncated, FallbackValue=False}" />
                  <WrapPanel>
                    <Button Classes="outline" Content="Add element" Margin="0,0,6,6" Command="{Binding ActiveTab.SelectedField.AddElementCommand, FallbackValue={x:Null}}" />
                    <Button Classes="outline" Content="Delete all" Margin="0,0,6,6" Command="{Binding ActiveTab.SelectedField.ClearElementsCommand, FallbackValue={x:Null}}" />
                  </WrapPanel>
                </StackPanel>

                <!-- Block element: insert / duplicate / delete -->
                <StackPanel Spacing="6" IsVisible="{Binding ActiveTab.SelectedField.IsBlockElement, FallbackValue=False}">
                  <TextBlock Text="ELEMENT" Classes="header" Margin="0,6,0,0" />
                  <WrapPanel>
                    <Button Classes="outline" Content="Insert before" Margin="0,0,6,6" Command="{Binding ActiveTab.SelectedField.InsertBeforeCommand, FallbackValue={x:Null}}" />
                    <Button Classes="outline" Content="Duplicate" Margin="0,0,6,6" Command="{Binding ActiveTab.SelectedField.DuplicateElementCommand, FallbackValue={x:Null}}" />
                    <Button Classes="outline" Content="Delete" Margin="0,0,6,6" Command="{Binding ActiveTab.SelectedField.DeleteElementCommand, FallbackValue={x:Null}}" />
                  </WrapPanel>
                </StackPanel>

                <!-- Reference: pick a tag of an allowed type -->
                <StackPanel Spacing="6" IsVisible="{Binding ActiveTab.SelectedField.IsReference, FallbackValue=False}">
                  <TextBlock Text="REFERENCE" Classes="header" Margin="0,6,0,0" />
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource KMuted}" FontSize="12">
                    <Run Text="Accepts " /><Run Text="{Binding ActiveTab.SelectedField.AllowedText, FallbackValue=''}" Foreground="{StaticResource KCode}" />
                  </TextBlock>
                  <WrapPanel>
                    <Button Classes="outline" Content="Open this file" Margin="0,0,6,6" Command="{Binding ActiveTab.OpenReferenceCommand, FallbackValue={x:Null}}" IsEnabled="{Binding ActiveTab.SelectedField.HasReferenceTarget, FallbackValue=False}" />
                    <Button Classes="outline" Content="Set to none" Margin="0,0,6,6" Command="{Binding ActiveTab.ClearReferenceCommand, FallbackValue={x:Null}}" />
                  </WrapPanel>
                  <TextBox Classes="compact" Watermark="Find a game file to use" Text="{Binding ActiveTab.ReferenceQuery, FallbackValue=''}" />
                  <ListBox x:Name="ReferenceList" Height="260" ItemsSource="{Binding ActiveTab.ReferenceResults, FallbackValue={x:Null}}" DoubleTapped="Reference_DoubleTapped"
                           Background="{StaticResource KBg}" BorderBrush="{StaticResource KBorder}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="sys:String">
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource KMono}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Classes="primary" Content="Use the selected file" HorizontalAlignment="Left"
                          Command="{Binding ActiveTab.PickReferenceCommand, FallbackValue={x:Null}}" CommandParameter="{Binding #ReferenceList.SelectedItem}" />
                </StackPanel>
              </StackPanel>
              </StackPanel>

              <!-- Gametype script: reference of actions and conditions -->
              <views:ScriptInspector IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasScript}" DataContext="{Binding ActiveScript}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
