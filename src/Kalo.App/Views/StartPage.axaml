<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:Kalo.App.ViewModels"
             x:Class="Kalo.App.Views.StartPage"
             x:DataType="vm:MainViewModel">
  <!-- The start page: shown in the main editor group when nothing is open there. -->
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel>
        <TextBlock Text="Kalo" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Halo Reach mod workbench." Foreground="{StaticResource KMuted}" />
      </StackPanel>

      <!-- No mod yet: create one -->
      <Border IsVisible="{Binding NoActiveMod}" Background="{StaticResource KPanel}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource KBorder}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="Start a mod" FontSize="15" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource KMuted}" FontSize="12.5"
                     Text="A mod holds only what you make or change: new maps, new gametypes, and any game file you tweak. It starts empty; add things from the My mod panel." />
          <TextBox Classes="compact" Watermark="Mod name (e.g. Rocket Race)" Text="{Binding NewModName}" Width="340" HorizontalAlignment="Left" />
          <TextBox Classes="compact" Watermark="One line about it (optional)" Text="{Binding NewModDescription}" Width="340" HorizontalAlignment="Left" />
          <Button Classes="primary" Content="Create the mod" Command="{Binding CreateModCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- A mod is active: what to do next -->
      <Border IsVisible="{Binding HasActiveMod}" Background="{StaticResource KPanel}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource KBorder}" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ActiveModName, StringFormat='Working on {0}'}" />
          <WrapPanel>
            <Button Classes="outline" Margin="0,0,8,8" Command="{Binding OpenNewMapFormCommand}" Padding="12,8">
              <StackPanel Spacing="2">
                <TextBlock Text="New map" FontWeight="SemiBold" />
                <TextBlock Text="Start from a Reach level, empty or full" FontSize="11.5" Foreground="{StaticResource KMuted}" />
              </StackPanel>
            </Button>
            <Button Classes="outline" Margin="0,0,8,8" Command="{Binding OpenNewGametypeFormCommand}" Padding="12,8">
              <StackPanel Spacing="2">
                <TextBlock Text="New gametype" FontWeight="SemiBold" />
                <TextBlock Text="Start from a simple script or a Reach mode" FontSize="11.5" Foreground="{StaticResource KMuted}" />
              </StackPanel>
            </Button>
            <Button Classes="outline" Margin="0,0,8,8" Command="{Binding OpenNodeCommand}" CommandParameter="objects\weapons\rifle\assault_rifle\assault_rifle.weapon" Padding="12,8">
              <StackPanel Spacing="2">
                <TextBlock Text="Tweak a weapon" FontWeight="SemiBold" />
                <TextBlock Text="e.g. the assault rifle's magazine" FontSize="11.5" Foreground="{StaticResource KMuted}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource KMuted}" FontSize="12"
                     Text="Press Play (F5) at the top to try it: pick the map and the gametype there. Other mods are in the Mod projects panel." />
        </StackPanel>
      </Border>

      <StackPanel Spacing="4">
        <TextBlock Text="QUICK OPEN (game files)" Classes="header" />
        <ItemsControl ItemsSource="{Binding QuickOpen}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <Button Classes="tool" HorizontalAlignment="Left" Content="{Binding}" FontFamily="{StaticResource KMono}" Foreground="{StaticResource KBlue}"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenNodeCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="HOW IT WORKS" Classes="header" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource KCode}"
                   Text="Everything you save goes into your mod (Kalo's workspace), never into HREK. Play (F5) saves first, then starts the chosen map and gametype in reach_tag_test; tags you save while it runs are reloaded by the game. My mod lists everything the mod contains; right-click a file to compare it with vanilla or take it out of the mod." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
