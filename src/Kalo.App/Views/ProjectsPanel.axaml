<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kalo.App.ViewModels"
             x:Class="Kalo.App.Views.ProjectsPanel"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="10,8" Spacing="8">
      <TextBlock Text="{Binding ActiveProjectText}" TextWrapping="Wrap" FontSize="12" />
      <WrapPanel>
        <Button Classes="outline" Content="Record changes" Margin="0,0,6,6" Command="{Binding CaptureProjectCommand}"
                ToolTip.Tip="Copy the workspace's changed files into the active project (also done on every save)" />
        <Button Classes="outline" Content="Export mod" Margin="0,0,6,6" Command="{Binding ExportProjectCommand}" CommandParameter="{x:Null}"
                ToolTip.Tip="Zip the active project's files into Kalo\exports" />
      </WrapPanel>
      <TextBlock Text="Switching…" Foreground="{StaticResource KWarning}" IsVisible="{Binding IsSwitching}" />

      <TextBlock Text="PROJECTS" Classes="header" Margin="0,6,0,0" />
      <ItemsControl ItemsSource="{Binding Projects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ProjectItem">
            <Border Classes="project" Classes.active="{Binding IsActive}" Padding="8,6" Margin="0,0,0,4" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource KBorder}">
              <StackPanel Spacing="2">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="active" FontSize="11" Foreground="{StaticResource KSuccess}" IsVisible="{Binding IsActive}" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                </DockPanel>
                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource KMuted}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource KFaint}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                  <Button Classes="tool" Content="Switch to" IsVisible="{Binding !IsActive}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SwitchProjectCommand}" CommandParameter="{Binding}" />
                  <Button Classes="tool" Content="Export"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ExportProjectCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="tool" Content="Back to vanilla (no project)" HorizontalAlignment="Left"
              Command="{Binding SwitchProjectCommand}" CommandParameter="{x:Null}" />

      <TextBlock Text="NEW PROJECT" Classes="header" Margin="0,10,0,0" />
      <TextBox Classes="compact" Watermark="Name (e.g. Faster rifles)" Text="{Binding NewProjectName}" />
      <TextBox Classes="compact" Watermark="Short description (optional)" Text="{Binding NewProjectDescription}" />
      <Button Classes="primary" Content="Create" HorizontalAlignment="Left" Command="{Binding CreateProjectCommand}" />
      <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource KMuted}"
                 Text="A project keeps only the files your mod changes (in Kalo\projects). All projects share one copy of HREK's tags, so switching takes seconds and costs no disk space." />
    </StackPanel>
  </ScrollViewer>
  <UserControl.Styles>
    <Style Selector="Border.project.active">
      <Setter Property="BorderBrush" Value="{StaticResource KAccent}" />
    </Style>
  </UserControl.Styles>
</UserControl>
