<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kalo.App.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:views="using:Kalo.App.Views"
             x:Class="Kalo.App.Views.ScriptEditorView"
             x:DataType="vm:ScriptEditorViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F7" Command="{Binding CompileCommand}" />
  </UserControl.KeyBindings>

  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="10,5" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
          <Button Classes="outline" Content="To Kalo Script" Command="{Binding ConvertToKaloScriptCommand}" IsVisible="{Binding IsMegaloText}"
                  ToolTip.Tip="Write this gametype in Kalo Script (if/then/else, for each, f(a, b)): a new .kscript in your mod; this file stays as it is" />
          <ToggleButton Classes="chip" Content="Settings" IsChecked="{Binding ShowSettings, Mode=OneWay}" Command="{Binding ToggleSettingsCommand}" IsVisible="{Binding IsKaloScript}"
                        ToolTip.Tip="Game settings, lobby options, player traits, map objects and constants as forms (like ReachVariantTool). Changes are written into the code." />
          <ToggleButton Classes="chip" Content="Megalo" IsChecked="{Binding ShowMegalo, Mode=OneWay}" Command="{Binding ToggleMegaloCommand}" IsVisible="{Binding IsKaloScript}"
                        ToolTip.Tip="Show the Megalo text this Kalo Script turns into (what HREK's compiler gets)" />
          <Button Classes="outline" Content="Export .bin" Command="{Binding ExportBinCommand}"
                  ToolTip.Tip="Save it as an MCC game type file (Kalo\exports\gametypes) to use in Custom Games. Experimental." />
          <Button Classes="outline" Content="Compile (F7)" Command="{Binding CompileCommand}" />
          <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" ToolTip.Tip="Save (Ctrl+S)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="True">
          <Ellipse Width="8" Height="8" Fill="{StaticResource KSuccess}" IsVisible="{Binding CompileOk}" />
          <TextBlock Text="{Binding CompileSummary}" Foreground="{StaticResource KMuted}" FontSize="12" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding CompileSummary}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" MaxHeight="160" BorderBrush="{StaticResource KBorder}" BorderThickness="0,1,0,0" Background="{StaticResource KPanel}"
            IsVisible="{Binding HasMessages}">
      <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ScriptMessage">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✕" Foreground="{StaticResource KError}" IsVisible="{Binding IsError}" />
              <TextBlock Text="!" Foreground="{StaticResource KWarning}" IsVisible="{Binding !IsError}" />
              <TextBlock Text="{Binding Where}" Foreground="{StaticResource KMuted}" FontFamily="{StaticResource KMono}" FontSize="11.5" MinWidth="60" />
              <TextBlock Text="{Binding Display}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid ColumnDefinitions="*,Auto">
      <!-- Hover help (filled in code) -->
      <Popup x:Name="HoverPopup" PlacementTarget="{Binding #Editor}" Placement="Pointer" HorizontalOffset="14" VerticalOffset="18"
             IsLightDismissEnabled="False" />
      <ae:TextEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="{StaticResource KMono}" FontSize="13"
                     Background="{StaticResource KBg}" Foreground="{StaticResource KText}" LineNumbersForeground="{StaticResource KFaint}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="6,4" IsVisible="{Binding ShowCode}" />
      <!-- Kalo Script: the call the caret is in, with the current argument marked (filled in code) -->
      <Border x:Name="CallHintBox" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0" Padding="8,4"
              Background="#E62B2D30" BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" MaxWidth="640">
        <TextBlock x:Name="CallHintText" FontFamily="{StaticResource KMono}" FontSize="12" Foreground="{StaticResource KCode}" TextWrapping="Wrap" />
      </Border>
      <!-- Kalo Script: the settings as forms, over the code -->
      <Panel IsVisible="{Binding ShowSettings}">
        <views:GametypeSettingsView x:Name="SettingsView" DataContext="{Binding GametypeSettings}" />
      </Panel>
      <!-- Kalo Script: the generated Megalo, read only -->
      <DockPanel Grid.Column="1" Width="460" IsVisible="{Binding ShowMegalo}" Background="{StaticResource KPanel}">
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="1,0,0,1" Padding="10,4">
          <TextBlock Text="GENERATED MEGALO (read only)" Classes="header" />
        </Border>
        <Border BorderBrush="{StaticResource KBorder}" BorderThickness="1,0,0,0">
          <ae:TextEditor x:Name="MegaloView" IsReadOnly="True" ShowLineNumbers="True" FontFamily="{StaticResource KMono}" FontSize="12"
                         Background="{StaticResource KPanel}" Foreground="{StaticResource KText}" LineNumbersForeground="{StaticResource KFaint}"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="6,4" />
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
