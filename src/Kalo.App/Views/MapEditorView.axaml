<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kalo.App.ViewModels"
             xmlns:vp="using:Kalo.App.Viewport"
             x:Class="Kalo.App.Views.MapEditorView"
             x:DataType="vm:MapEditorViewModel">

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1">
      <!-- What to show, then actions; the actions go to a second row when the editor is narrow (split view). -->
      <WrapPanel Orientation="Horizontal" Margin="10,2">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,24,3">
          <TextBlock Text="Show" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ToggleButton Classes="chip" Content="Level" IsChecked="{Binding ShowGeometry}" />
          <ToggleButton Classes="chip" Content="Scenery" IsChecked="{Binding ShowScenery}" />
          <ToggleButton Classes="chip" Content="Items" IsChecked="{Binding ShowItems}" />
          <ToggleButton Classes="chip" Content="Vehicles" IsChecked="{Binding ShowVehicles}" />
          <ToggleButton Classes="chip" Content="Devices" IsChecked="{Binding ShowDevices}" />
          <ToggleButton Classes="chip" Content="Sound/FX" IsChecked="{Binding ShowSoundAndEffects}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3">
          <Button Classes="tool" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoText, StringFormat='{}{0} (Ctrl+Z)'}">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE7A7;" />
          </Button>
          <Button Classes="tool" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE7A6;" />
          </Button>
          <Button Classes="outline" Command="{Binding PlayFromCameraCommand}"
                  ToolTip.Tip="Play this map starting here: on the ground under the camera, facing where it looks (Ctrl+F5). The map's Start location does not move.">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE768;" VerticalAlignment="Center" FontSize="11" />
              <TextBlock Text="Play here" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="outline" Content="Spawn view" Command="{Binding ViewFromSpawnCommand}" IsEnabled="{Binding HasSpawn}"
                  ToolTip.Tip="Camera where the player spawns, at eye height: compare with the game" />
          <Button Classes="outline" Content="Frame all" Command="{Binding FrameAllCommand}" ToolTip.Tip="Put the camera back over the play space (Home)" />
          <Button Classes="outline" Content="Script objects" Command="{Binding AddScriptObjectsCommand}"
                  ToolTip.Tip="Add the objects your mod lets scripts create (Use in scripts) to the objects this map uses, so gametypes can create them here. Nothing is placed." />
          <Button Classes="outline" Content="Fields" Command="{Binding OpenFieldsCommand}" ToolTip.Tip="Every setting of this map, in the field editor (advanced)" />
          <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" ToolTip.Tip="Save (Ctrl+S)" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Campaign missions: their markers, zone sets, mission scripts and cutscenes -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" IsVisible="{Binding IsCampaign}">
      <!-- Groups wrap to a second row when the editor is narrow -->
      <WrapPanel Orientation="Horizontal" Margin="10,2">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2">
          <TextBlock Text="Campaign" Foreground="{StaticResource KAccentText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ToggleButton Classes="chip" Content="Volumes" IsChecked="{Binding ShowVolumes}" ToolTip.Tip="Trigger volumes: areas mission scripts test (players inside...), zone set switches, kill and safe zones" />
          <ToggleButton Classes="chip" Content="AI" IsChecked="{Binding ShowAi}" ToolTip.Tip="Squad spawn points: where each AI of a squad appears (red markers)" />
          <ToggleButton Classes="chip" Content="Cutscenes" IsChecked="{Binding ShowCutscene}" ToolTip.Tip="Cutscene flags and camera points used by mission scripts" />
          <ToggleButton Classes="chip" Content="Script points" IsChecked="{Binding ShowScriptPoints}" ToolTip.Tip="Points of point sets: where scripts send AI" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2">
          <TextBlock Text="Zone set" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ZoneSetChoices}" SelectedItem="{Binding SelectedZoneSet}" MinWidth="200" MaxWidth="320" MinHeight="24" FontSize="12"
                    ToolTip.Tip="Show only the level pieces a zone set loads (what Sapien calls Switch zone set). Play here (Ctrl+F5) loads this zone set." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2">
          <TextBlock Text="Add" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
          <Button Classes="outline" Content="Volume" Command="{Binding AddMarkerCommand}" CommandParameter="trigger volumes"
                  ToolTip.Tip="A new trigger volume (a 4 x 4 x 3 box) in front of the camera. Rename it so scripts can use it." />
          <Button Classes="outline" Content="Flag" Command="{Binding AddMarkerCommand}" CommandParameter="cutscene flags"
                  ToolTip.Tip="A new cutscene flag (a named point for scripts) in front of the camera" />
          <Button Classes="outline" Content="Camera" Command="{Binding AddCameraHereCommand}"
                  ToolTip.Tip="A new cutscene camera point that shows exactly what this view shows. Scripts use it with camera_set." />
          <Button Classes="outline" Content="Spawn point" Command="{Binding AddMarkerCommand}" CommandParameter="ai spawn points"
                  ToolTip.Tip="Another spawn point for the squad of the selected spawn point, in front of the camera" />
          <Button Classes="outline" Content="Squad" Command="{Binding AddSquadCommand}"
                  ToolTip.Tip="A new squad in front of the camera: one AI (an Elite when the mission has one), team covenant. Change what it spawns in the Squad section; a script places it with ai_place(name)." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2">
          <Button Classes="outline" Content="Player gear" Command="{Binding LoadGearCommand}" ToolTip.Tip="What the player starts this mission with: weapons, grenades, armor ability">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <Grid ColumnDefinitions="110,220" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                  <Grid.Styles><Style Selector="ComboBox, TextBox"><Setter Property="Margin" Value="0,0,0,4" /></Style></Grid.Styles>
                  <TextBlock Text="Main weapon" VerticalAlignment="Center" FontSize="12" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding GearWeapons}" SelectedItem="{Binding GearPrimary}" HorizontalAlignment="Stretch" FontSize="12" />
                  <TextBlock Grid.Row="1" Text="Second weapon" VerticalAlignment="Center" FontSize="12" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GearWeapons}" SelectedItem="{Binding GearSecondary}" HorizontalAlignment="Stretch" FontSize="12" />
                  <TextBlock Grid.Row="2" Text="Armor ability" VerticalAlignment="Center" FontSize="12" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding GearEquipment}" SelectedItem="{Binding GearAbility}" HorizontalAlignment="Stretch" FontSize="12" />
                  <TextBlock Grid.Row="3" Text="Frag grenades" VerticalAlignment="Center" FontSize="12" />
                  <TextBox Grid.Row="3" Grid.Column="1" Classes="compact" Text="{Binding GearFrags}" />
                  <TextBlock Grid.Row="4" Text="Plasma grenades" VerticalAlignment="Center" FontSize="12" />
                  <TextBox Grid.Row="4" Grid.Column="1" Classes="compact" Text="{Binding GearPlasmas}" />
                  <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Apply" Command="{Binding ApplyGearCommand}" />
                    <TextBlock Text="{Binding GearStatus}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240" />
                  </StackPanel>
                </Grid>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2" IsVisible="{Binding Selected.IsCamera, FallbackValue=False}">
          <TextBlock Text="Camera" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
          <Button Classes="outline" Content="Look through" Command="{Binding LookThroughCameraCommand}"
                  ToolTip.Tip="Moves this view to the selected camera point, to see what it shows" />
          <Button Classes="outline" Content="Set to view" Command="{Binding SetCameraToViewCommand}"
                  ToolTip.Tip="Moves the selected camera point to this view" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2">
          <TextBlock Text="Level pieces" Foreground="{StaticResource KMuted}" FontSize="12" VerticalAlignment="Center" />
          <Button Classes="outline" Content="Here" Command="{Binding FindLevelPiecesCommand}"
                  ToolTip.Tip="The level's own pieces (buildings, rocks, pipes, crates) at the center of the view: aim at one, click, then Hide it or its whole building" />
          <Button Classes="outline" Content="Hidden" Command="{Binding HiddenLevelPiecesCommand}"
                  ToolTip.Tip="Every level piece hidden in this map, to show them again" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2">
          <Button Classes="outline" IsEnabled="{Binding HasMissionScripts}" ToolTip.Tip="Open one of the mission's scripts (HaloScript). This map's own copies come first.">
            <Button.Content>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Mission scripts" />
                <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
              </StackPanel>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding MissionScripts}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MissionFile">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="ToolTip.Tip" Value="{Binding Hint}" />
                    <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:MapEditorViewModel)DataContext).OpenMissionScriptCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="outline" IsEnabled="{Binding HasCutscenes}" ToolTip.Tip="The mission's cutscenes, opened in the field editor">
            <Button.Content>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Cutscenes" />
                <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
              </StackPanel>
            </Button.Content>
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding Cutscenes}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MissionFile">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
                    <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:MapEditorViewModel)DataContext).OpenCutsceneCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Live game: test in the running game without restarting it -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KBorder}" BorderThickness="0,0,0,1" Background="{StaticResource KPanelAlt}" IsVisible="{Binding IsGameRunning}">
      <WrapPanel Orientation="Horizontal" Margin="10,2">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,14,2">
          <TextBlock Text="Live game" Foreground="LimeGreen" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"
                     ToolTip.Tip="The game is running: these act on it right away, no restart" />
          <Button Classes="outline" Content="Move me to the camera" Command="{Binding LiveTeleportCommand}"
                  ToolTip.Tip="Moves your player in the game to the ground under this view's camera, facing where it looks" />
          <Button Classes="outline" Content="Spawn this squad" Command="{Binding LiveSpawnSquadCommand}" IsVisible="{Binding IsCampaign}"
                  ToolTip.Tip="Places the selected spawn point's squad in the game now (ai_place). Save and restart with Play for squads added or changed since the game started." />
          <Button Classes="outline" Content="Show this camera" Command="{Binding LivePreviewCameraCommand}" IsVisible="{Binding Selected.IsCamera, FallbackValue=False}"
                  ToolTip.Tip="Shows the selected camera point in the game (camera_control, camera_set). Save and restart with Play for cameras added or moved since the game started." />
          <Button Classes="outline" Content="View back on player" Command="{Binding LiveCameraBackCommand}" IsVisible="{Binding IsCampaign}"
                  ToolTip.Tip="Gives the view back to the player (camera_control 0)" />
          <Button Classes="outline" Content="Remove all AI" Command="{Binding LiveRemoveAiCommand}" IsVisible="{Binding IsCampaign}"
                  ToolTip.Tip="Removes every AI from the game (ai_erase_all)" />
          <Button Classes="outline" Content="Load this zone set" Command="{Binding LiveSwitchZoneSetCommand}" IsVisible="{Binding IsCampaign}"
                  ToolTip.Tip="Switches the game to the zone set picked in the Campaign bar (switch_zone_set): its level pieces load" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,2,14,2">
          <CheckBox Content="Can't die" IsChecked="{Binding LiveInvincible}" FontSize="12" ToolTip.Tip="cheat_deathless_player" />
          <CheckBox Content="Infinite ammo" IsChecked="{Binding LiveInfiniteAmmo}" FontSize="12" ToolTip.Tip="cheat_infinite_ammo" />
          <TextBlock Text="{Binding LiveStatus}" Foreground="{StaticResource KMuted}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Objects off the level geometry: removed by the game -->
    <Border DockPanel.Dock="Bottom" Background="#3A1D1D" BorderBrush="#E5534B" BorderThickness="0,1,0,0" Padding="10,4" IsVisible="{Binding HasOutside}">
      <TextBlock Text="{Binding OutsideText}" FontSize="12" Foreground="#F0A8A3" TextWrapping="Wrap" />
    </Border>

    <!-- Status line -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource KPanel}" BorderBrush="{StaticResource KBorder}" BorderThickness="0,1,0,0" Height="24">
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="10,0" VerticalAlignment="Center">
        <!-- Working: what the map is doing (an edit, an undo, reading the map), so a slow step doesn't look like a dead button -->
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="60" Height="4" MinHeight="4" VerticalAlignment="Center" />
          <TextBlock Text="{Binding BusyText}" FontSize="11.5" Foreground="{StaticResource KAccentText}" />
        </StackPanel>
        <TextBlock Text="{Binding GeometryStatus}" FontSize="11.5" Foreground="{StaticResource KMuted}" />
        <TextBlock Text="{Binding RendererStatus}" FontSize="11.5" Foreground="{StaticResource KFaint}" />
        <TextBlock Text="{Binding ChangesText}" FontSize="11.5" Foreground="{StaticResource KWarning}" />
        <TextBlock Text="{Binding KeyHint}" FontSize="11.5" Foreground="{StaticResource KFaint}" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="220,4,*">
      <!-- Outliner: editor folders, then loose objects by kind. Colors: green new, amber changed. -->
      <DockPanel Grid.Column="0" Background="{StaticResource KPanel}">
        <DockPanel DockPanel.Dock="Top" Margin="6,6,6,2">
          <Button DockPanel.Dock="Right" Classes="tool" Padding="6,2" Click="NewFolder_Click" ToolTip.Tip="New folder (the selected objects go in it)">
            <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE8F4;" />
          </Button>
          <TextBox Classes="compact" Watermark="Filter objects" Text="{Binding Filter}" Margin="0,0,4,0" />
        </DockPanel>
        <TreeView x:Name="Outliner" ItemsSource="{Binding OutlinerRoots}" SelectionMode="Multiple" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="Outliner_SelectionChanged" DoubleTapped="Outliner_DoubleTapped" KeyDown="Outliner_KeyDown">
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:OutlinerNode" ItemsSource="{Binding Children}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="11" Foreground="{Binding StateBrush, FallbackValue={StaticResource KFaint}, TargetNullValue={StaticResource KFaint}}"
                           IsVisible="{Binding !IsItem}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="11" Foreground="{Binding StateBrush}"
                           IsVisible="{Binding IsItem}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource KIcons}" Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0"
                           Foreground="{StaticResource KMuted}" IsVisible="{Binding !IsItem}" VerticalAlignment="Center" />
                <StackPanel Spacing="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                             Foreground="{Binding StateBrush, TargetNullValue={StaticResource KText}, FallbackValue={StaticResource KText}}" />
                  <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource KFaint}" FontFamily="{StaticResource KMono}"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding IsItem}" />
                  <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{StaticResource KFaint}" IsVisible="{Binding HasKind}" />
                </StackPanel>
              </DockPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:OutlinerNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="MinHeight" Value="22" />
            </Style>
          </TreeView.Styles>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Go to (double-click)" Click="GoTo_Click" />
              <MenuItem Header="Rename… (F2)" Click="Rename_Click" />
              <Separator />
              <MenuItem Header="Copy" Command="{Binding CopySelectionCommand}" />
              <MenuItem Header="Cut" Command="{Binding CutSelectionCommand}" />
              <MenuItem Header="Paste in front of the camera" Command="{Binding PasteCommand}" />
              <MenuItem Header="Duplicate" Command="{Binding DuplicateSelectedCommand}" />
              <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" />
              <Separator />
              <MenuItem Header="New folder…" Click="NewFolder_Click" />
              <MenuItem Header="Move to folder" ItemsSource="{Binding FolderChoices}">
                <MenuItem.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:FolderChoice">
                    <Setter Property="Header" Value="{Binding Path}" />
                    <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:MapEditorViewModel)DataContext).MoveSelectionToFolderCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding Index}" />
                  </ControlTheme>
                </MenuItem.ItemContainerTheme>
              </MenuItem>
              <MenuItem Header="Rename folder…" Click="RenameFolder_Click" IsEnabled="{Binding HasSelectedFolder}" />
              <MenuItem Header="Delete folder (keeps its objects)" Command="{Binding DeleteFolderCommand}" IsEnabled="{Binding HasSelectedFolder}" />
              <Separator />
              <MenuItem Header="Create prefab from selection…" Click="CreatePrefab_Click" />
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>
      </DockPanel>
      <GridSplitter Grid.Column="1" Background="{StaticResource KBorder}" ResizeDirection="Columns" />
      <vp:MapViewport Grid.Column="2" x:Name="Viewport" />
      <!-- Block tools, left edge of the view like Blender's toolbar: place Forge pieces, paint them. -->
      <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Orientation="Horizontal" Spacing="6">
        <Border Background="#CC232427" BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="6" Padding="3" VerticalAlignment="Top">
          <StackPanel Spacing="2">
            <ItemsControl ItemsSource="{Binding Tools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BlockTool">
                  <Button Classes="block" Command="{Binding $parent[UserControl].((vm:MapEditorViewModel)DataContext).PlaceBlockCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Tip}" ToolTip.Placement="Right">
                    <StackPanel Spacing="1">
                      <TextBlock FontFamily="{StaticResource KIcons}" Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="9.5" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{StaticResource KBorder}" Margin="2,3" />
            <ToggleButton Classes="block" IsChecked="{Binding IsPaintOpen, Mode=OneWay}" Command="{Binding TogglePaintCommand}"
                          ToolTip.Tip="Paint the selected blocks with a material" ToolTip.Placement="Right">
              <StackPanel Spacing="1">
                <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE771;" FontSize="15" HorizontalAlignment="Center" />
                <TextBlock Text="Paint" FontSize="9.5" HorizontalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="block" IsChecked="{Binding SnapToGrid}" ToolTip.Tip="Snap new blocks to a half-unit grid" ToolTip.Placement="Right">
              <StackPanel Spacing="1">
                <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE80A;" FontSize="15" HorizontalAlignment="Center" />
                <TextBlock Text="Snap" FontSize="9.5" HorizontalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>
        <!-- Materials -->
        <Border IsVisible="{Binding IsPaintOpen}" Background="#EE232427" BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="6"
                Padding="8" Width="300" MaxHeight="460" VerticalAlignment="Top">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="MATERIALS" Classes="header" Margin="0,0,0,2" />
            <TextBlock DockPanel.Dock="Top" Text="Select objects (blocks, crates, scenery, weapons...), then click a material. Kalo saves a painted copy of each in your mod."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KMuted}" Margin="0,0,0,6" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).Materials}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:MaterialChoice">
                    <Button Classes="swatch" Command="{Binding $parent[UserControl].((vm:MapEditorViewModel)DataContext).PaintCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Shader}">
                      <StackPanel Width="62" Spacing="2">
                        <Image Source="{Binding Swatch}" Width="62" Height="62" Stretch="UniformToFill" />
                        <TextBlock Text="{Binding Name}" FontSize="9.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource KMuted}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- Viewport shading, top right like Blender's header: Wireframe / Solid / Textured, plus an edge overlay. -->
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Spacing="4">
        <Border Background="#CC232427" BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="6" Padding="3"
                HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="seg" Classes.on="{Binding IsWireframe}" Content="Wireframe" Command="{Binding SetShadingCommand}" CommandParameter="Wireframe"
                    ToolTip.Tip="Edges only, see through everything (Z cycles the modes)" />
            <Button Classes="seg" Classes.on="{Binding IsSolid}" Content="Solid" Command="{Binding SetShadingCommand}" CommandParameter="Solid"
                    ToolTip.Tip="Plain shaded surfaces: floors warm, walls cool, 1-unit grid (Z cycles the modes)" />
            <Button Classes="seg" Classes.on="{Binding IsTextured}" Content="Textured" Command="{Binding SetShadingCommand}" CommandParameter="Textured"
                    ToolTip.Tip="The color maps of the level and objects (Z cycles the modes). Decoded once, then cached." />
            <Border Width="1" Background="{StaticResource KBorder}" Margin="3,2" />
            <ToggleButton Classes="seg" Content="Edges" IsChecked="{Binding WireOverlay}"
                          ToolTip.Tip="Draw triangle edges over Solid and Textured" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding TextureStatus}" IsVisible="{Binding TextureStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource KMuted}" />
        <!-- Level pieces: the level's own buildings, rocks, crates (Campaign bar › Level pieces) -->
        <Border Background="#E6232427" BorderBrush="{StaticResource KBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6"
                Width="360" HorizontalAlignment="Right" IsVisible="{Binding ShowLevelPieces}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Classes="tool" Padding="6,2" Command="{Binding CloseLevelPiecesCommand}" ToolTip.Tip="Close">
                <TextBlock FontFamily="{StaticResource KIcons}" Text="&#xE8BB;" FontSize="10" />
              </Button>
              <TextBlock Text="{Binding LevelPiecesTitle}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Foreground="{StaticResource KFaint}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Hidden pieces are gone in the game (they are shrunk to nothing in this map's own copy of the level; the original level is untouched). Ctrl+Z does not undo this: use Show. Their baked shadows stay." />
            <Button DockPanel.Dock="Bottom" Classes="outline" Content="Show them all" Command="{Binding ShowAllPiecesCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    IsVisible="{Binding CanShowAllPieces}" />
            <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding LevelPieces}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LevelPieceRow">
                    <DockPanel Margin="0,2" Opacity="{Binding Opacity}">
                      <Button DockPanel.Dock="Right" Classes="outline" Content="{Binding GroupText}" IsVisible="{Binding HasGroup}" Margin="4,0,0,0" FontSize="11"
                              Command="{Binding $parent[UserControl].((vm:MapEditorViewModel)DataContext).ToggleGroupCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding GroupTip}" />
                      <Button DockPanel.Dock="Right" Classes="outline" Content="{Binding ToggleText}" Margin="4,0,0,0" FontSize="11"
                              Command="{Binding $parent[UserControl].((vm:MapEditorViewModel)DataContext).TogglePieceCommand}" CommandParameter="{Binding}" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource KFaint}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
  </DockPanel>

  <UserControl.Styles>
    <Style Selector="Button.block, ToggleButton.block">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource KText}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.block:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource KAccent}" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.seg, ToggleButton.seg">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource KMuted}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.seg.on, ToggleButton.seg:checked">
      <Setter Property="Background" Value="{StaticResource KAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.seg.on /template/ ContentPresenter, ToggleButton.seg:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource KAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.chip">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
  </UserControl.Styles>
</UserControl>
