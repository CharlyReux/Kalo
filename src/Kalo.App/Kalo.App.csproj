<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kalo: the desktop app (Avalonia, .NET 8). Talks to ManagedBlam through kalo-blamhost.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kalo</AssemblyName>
    <RootNamespace>Kalo.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The exe's icon (desktop shortcuts, Explorer). Drawn from docs\images\kalo-icon.svg. -->
    <ApplicationIcon>Assets\kalo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon (title bar, taskbar). -->
    <AvaloniaResource Include="Assets\kalo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gamepad routing for split-screen playtests (source in tools\xinput, built with mingw-w64). -->
    <None Include="..\..\tools\xinput\xinput1_4.dll" Link="xinput\xinput1_4.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kalo.Core\Kalo.Core.csproj" />
    <!-- Build order only: the app starts the Blam Host from its build output. -->
    <ProjectReference Include="..\Kalo.BlamHost\Kalo.BlamHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
