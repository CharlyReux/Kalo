<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Blam Host: the only Kalo process that loads ManagedBlam (a .NET Framework 4.x, x64-only
    C++/CLI DLL). The Kalo app starts it, talks to it over a named pipe, and restarts it if the
    engine halts. All ManagedBlam calls run on this process's main thread.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>kalo-blamhost</AssemblyName>
    <RootNamespace>Kalo.BlamHost</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kalo.Spike0\BlamLoader.cs" Link="Shared\BlamLoader.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kalo.Protocol\Kalo.Protocol.csproj" />
    <Reference Include="ManagedBlam">
      <HintPath>$(HrekRoot)\bin\ManagedBlam.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ManagedMegalo defines its own copies of some Bungie.* types, so it gets an alias. -->
    <Reference Include="ManagedMegalo">
      <HintPath>$(HrekRoot)\bin\ManagedMegalo.dll</HintPath>
      <Private>false</Private>
      <Aliases>megalo</Aliases>
    </Reference>
  </ItemGroup>

</Project>
